# --- Shown in the page (no secrets) -----------------------------------------
# Where the shop lives. Checkout and payment checks go through it.
NEXT_PUBLIC_SHOP_ORIGIN=https://www.goldengoosetools.com
# Served under the shop at this path (default shown).
# NEXT_PUBLIC_BASE_PATH=/tools/fix-it
# Price labels shown on the page, in cents. Must match the shop's own prices
# (the shop decides what is actually charged).
NEXT_PUBLIC_PRICE_STANDARD_CENTS=14900
NEXT_PUBLIC_PRICE_PLUS_CENTS=24900

# --- Server only: required for requests to reach you -------------------------
# Checkout stays closed ("not taking new requests") until BOTH of these are set.
# RESEND_API_KEY=
# FIX_IT_NOTIFY_EMAIL=you@example.com

# --- Server only: optional ---------------------------------------------------
# Sender for the notification. Defaults to Resend's shared test sender
# (onboarding@resend.dev), which can only deliver to the email on the Resend account.
# Use an address on a domain verified in Resend to send anywhere.
# FIX_IT_FROM_EMAIL="Golden Goose Tools <requests@your-verified-domain.com>"
