# Shop origin that owns Stripe (no secrets in this repo).
NEXT_PUBLIC_SHOP_ORIGIN=https://goldengoosetools.com

# Optional subpath when mounted under the shop.
# NEXT_PUBLIC_BASE_PATH=/tools/fix-it

# Comma list of sale products the shop desk currently accepts.
# TODAY: seo-audit,accessibility only. Until "fix-it" appears, checkout is refused
# (sending product=fix-it before allowlist merge would be priced as SEO $29).
NEXT_PUBLIC_SHOP_SALE_PRODUCTS=seo-audit,accessibility

# Prices in cents, mirrored from shop lib/config.ts (standard / plus).
# Leave unset until the shop publishes Fix It — never invent $149/$249 in code.
# NEXT_PUBLIC_PRICE_STANDARD_CENTS=14900
# NEXT_PUBLIC_PRICE_PLUS_CENTS=24900

# Local unlock only — never enable in production.
# NEXT_PUBLIC_ALLOW_LOCAL_UNLOCK=true
